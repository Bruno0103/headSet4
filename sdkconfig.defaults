CONFIG_IDF_TARGET="esp32"
CONFIG_SPI_FLASH_SUPPORT_BOYA_CHIP=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
#CONFIG_LV_COLOR_DEPTH_16=y
#CONFIG_LV_COLOR_DEPTH=16
#CONFIG_LV_USE_OBJ_NAME=y
#CONFIG_LV_USE_TRANSLATION=y
#CONFIG_LV_USE_FS_MEMFS=y
#CONFIG_LV_FS_MEMFS_LETTER=77
CONFIG_PARTITION_TABLE_SINGLE_APP=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_DAC_DMA_AUTO_16BIT_ALIGN=n
# CONFIG_LV_MEM_SIZE_KILOBYTES=64
# --- Bluetooth Classic: A2DP + AVRCP + HFP client ---
# Confira os nomes no menuconfig (Component config -> Bluetooth) do seu IDF.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y
CONFIG_BT_AVRCP_ENABLED=y

# Chamadas (passos 4 e 5): audio SCO pelo HCI, para chegar nos callbacks de dados
CONFIG_BT_HFP_ENABLE=y
CONFIG_BT_HFP_CLIENT_ENABLE=y
CONFIG_BT_HFP_AUDIO_DATA_PATH_HCI=y
CONFIG_BT_HFP_WBS_ENABLE=y          # mSBC (16 kHz); sem isso so CVSD (8 kHz)

# Economiza RAM: so Classic (menuconfig -> Bluetooth -> Controller -> Bluetooth controller mode = BR/EDR only)

