CONFIG_IDF_TARGET="esp32"
CONFIG_SPI_FLASH_SUPPORT_BOYA_CHIP=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
# Tabela propria (partitions.csv): app de 4 MB para caber LVGL + assets
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_DAC_DMA_AUTO_16BIT_ALIGN=n

# --- Controlador Bluetooth: modo dual (Classic + BLE) ---
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BTDM=y
CONFIG_BTDM_CTRL_BLE_MAX_CONN=2
CONFIG_BTDM_CTRL_BR_EDR_MAX_ACL_CONN=2
# Controlador no core 0 (PRO) e audio no core 1 (APP)
CONFIG_BTDM_CTRL_PINNED_TO_CORE_0=y
# Audio SCO/eSCO pelo HCI (chega nos callbacks de dados do HFP)
CONFIG_BTDM_CTRL_BR_EDR_SCO_DATA_PATH_HCI=y

# --- Host Bluedroid: Classic + BLE (GATT server) ---
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLUEDROID_PINNED_TO_CORE_0=y
CONFIG_BT_BTC_TASK_STACK_SIZE=4096
CONFIG_BT_BTU_TASK_STACK_SIZE=6144
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y
CONFIG_BT_AVRCP_ENABLED=y
CONFIG_BT_ACL_CONNECTIONS=3
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_GATTS_ENABLE=y
CONFIG_BT_GATTC_ENABLE=n
CONFIG_BT_BLE_SMP_ENABLE=y
# Endereco privado resolvivel (RPA) para o advertising nao-descobrivel
CONFIG_BT_BLE_RPA_SUPPORTED=y
CONFIG_BT_BLE_RPA_TIMEOUT=900

# --- HFP client (WBS / mSBC) ---
CONFIG_BT_HFP_ENABLE=y
CONFIG_BT_HFP_CLIENT_ENABLE=y
CONFIG_BT_HFP_AUDIO_DATA_PATH_HCI=y
CONFIG_BT_HFP_WBS_ENABLE=y

# --- PSRAM (WROVER): so por heap_caps explicito (buffer de musica); malloc() continua na RAM interna ---
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y

# --- Economia de memoria ---
# Otimiza por tamanho (-Os): reduz flash e IRAM; o DSP (EQ/AGC) sobra folga a 160 MHz
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
# Host Bluedroid aloca na PSRAM primeiro (libera ~50 KB de .bss e boa parte do heap interno);
# DYNAMIC_ENV_MEMORY tira as estruturas estaticas do .bss e as manda para o heap (-> PSRAM)
CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=y
CONFIG_BT_BLE_DYNAMIC_ENV_MEMORY=y
# Recursos do stack que o fone nao usa
CONFIG_BT_AVRCP_CT_COVER_ART_ENABLED=n
CONFIG_BT_BLE_42_DTM_TEST_EN=n
CONFIG_BTDM_CTRL_FULL_SCAN_SUPPORTED=n
CONFIG_BTDM_BLE_SCAN_DUPL=n
# Timers do esp_timer nao precisam rodar com o cache desligado (so tarefas/NVS)
CONFIG_ESP_TIMER_IN_IRAM=n
CONFIG_LIBC_MISC_IN_IRAM=n
# Permite EXT_RAM_BSS_ATTR (pool do LVGL e outros buffers grandes na PSRAM)
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
